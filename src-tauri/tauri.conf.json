{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MovieBox",
  "version": "1.3.3",
  "identifier": "com.moviebox.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MovieBox",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "MovieBox",
    "shortDescription": "Watch and download movies and series",
    "copyright": "MovieBox-Tui (MIT/Apache-2.0), mpv (LGPL)",
    "resources": {
      "lib/*": "lib/",
      "docs/*": "docs/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./installer/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    },
    "longDescription": "MovieBox lets you browse, stream and download movies and series with a built-in player.",
    "createUpdaterArtifacts": false,
    "externalBin": [
      "bin/ffmpeg"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/vikasdigitalcreations/movies/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3Njc2QjBBMzdFNEEyNQpSV1FsU242anNIWjJBbFhlRWhFLzFMMDVERXdrNWJZTjZBbXB0MnpsVTJ4L3Z0YnoyNGpDeDNycgo=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
